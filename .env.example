# Google Cloud OAuth 2.0 Web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate once with: openssl rand -hex 32
# Keep this stable. Changing it makes stored Gmail refresh tokens unreadable.
CONNECTION_TOKEN_ENCRYPTION_KEY=

# Must match the origin users open and the Google OAuth authorized redirect URI.
# Local redirect URI: http://localhost:5173/api/oauth/google/callback
APP_BASE_URL=http://localhost:5173

# This integration intentionally refuses to save a different Gmail account.
GMAIL_ALLOWED_EMAIL=info@paintersottawa.com

# Optional server settings.
API_PORT=8787
GMAIL_HEALTH_CHECK_INTERVAL_MS=300000
GMAIL_ACTIVITY_SYNC_INTERVAL_MS=300000
GMAIL_SYNC_LOOKBACK_DAYS=30
GMAIL_SYNC_MAX_MESSAGES=2000

# Public project origin. Database secret keys remain inside Supabase Edge Functions.
SUPABASE_PROJECT_URL=https://bwbckdkouqghdadpkjvn.supabase.co

# Existing Ottawa Painters Hermes Cloud runtime. No Hermes credential is exposed to the browser.
HERMES_BASE_URL=https://ottawa-painters-hermes-5745.agents.nousresearch.com
# Optional dedicated bearer credential for the read-only Hermes history bridge.
# When omitted, Fluid derives a separate credential from CONNECTION_TOKEN_ENCRYPTION_KEY.
# HERMES_HISTORY_TOKEN=
# CONNECTION_STORE_PATH=.data/connections.json
