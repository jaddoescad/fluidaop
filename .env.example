# Google Cloud OAuth 2.0 Web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate once with: openssl rand -hex 32
# Keep this stable. Changing it makes stored Gmail refresh tokens unreadable.
CONNECTION_TOKEN_ENCRYPTION_KEY=

# Must match the origin users open and the Google OAuth authorized redirect URI.
# Local redirect URI: http://localhost:5173/api/oauth/google/callback
APP_BASE_URL=http://localhost:5173

# This integration intentionally refuses to save a different Gmail account.
GMAIL_ALLOWED_EMAIL=info@paintersottawa.com

# Optional server settings.
API_PORT=8787
GMAIL_HEALTH_CHECK_INTERVAL_MS=300000
# CONNECTION_STORE_PATH=.data/connections.json
